# NSV pipeline — ONE settings file for every stage. Copy to .env (cp .env.example .env) and fill in.
# An environment variable of the same name wins. Never commit .env (it holds the database password).

# ---------- S3: raw input, bronze, silver (bronze/, silver/) ----------
BUCKET=dhms-new-stgae
REGION=ap-south-1
RAW_S3_ROOT=s3://nhai-dhms-uat/nsv-dowloads-raw//unity-catalog/7474657023733156/__unitystorage/catalogs/55f24056-457d-4fa3-8b3e-37e087c38424/volumes/6fb3a2ad-d441-4118-84d9-c5b01fe405db/
BRONZE_PREFIX=DHMS/NSV/Bronze
SILVER_PREFIX=DHMS/NSV/Silver
MASTER_PROJECT_S3=s3://dhms-new-stgae/NSV/DHMS/DIC_Staging/Latest/master_upc_project.csv
# local scratch folder of the silver run (bronze download + silver output before the upload)
WORK_DIR=/root/nsv_work

# ---------- Images (images/): breach images of master_pothole / master_cracking_10m → CDN ----------
IMAGE_UPLOAD_URL=https://nhaidhms-stage-api.dic.org.in/defects/images/upload
IMAGE_UPLOAD_WORKERS=4

# ---------- Database (push_silver/, push_gold/) ----------
DB_HOST=dhms-development-dhms-development-postgresql.cdk480kqufch.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=dhms_uat
DB_USER=dhms_admin
DB_SCHEMA=public
# Password: DB_PASSWORD, or the name of an AWS Secrets Manager secret (used only when DB_PASSWORD is empty)
DB_PASSWORD=
DB_SECRET_NAME=
# project master in the database: the UPC's ids (project_id, region_id, …) are written into every silver table
MASTER_PROJECT_TABLE=master_upc_project

# ---------- Gold (gold/) ----------
RIS_KPI_STORAGE=s3
# DB tables as written to S3 by the existing DB export job (statuses, master_upc_project, survey ids, ...)
S3_DB_TABLES_DIR=s3://dhms-new-stgae/NSV/DHMS/DIC_Staging/Latest
# silver tables gold reads (= s3://BUCKET/SILVER_PREFIX)
S3_SILVER_INPUT_DIR=s3://dhms-new-stgae/DHMS/NSV/Silver
# gold output: year=/month=/day=/ and Latest/ (push_gold reads Latest/)
S3_GOLD_OUTPUT_DIR=s3://dhms-new-stgae/DHMS/NSV/Gold
# ris_view_data / ris_trends_data rows without upc_id / survey_id / survey_source_id: True = dropped (logged)
DROP_ROWS_WITHOUT_IDS=True

# ---------- Run (run.py) ----------
# stages that run, in this order (remove one to switch it off)
STAGES=bronze,silver,images,push_silver,gold,push_gold
# surveys of a run: zone, phase, cycle, upc
SURVEYS_FILE=surveys.csv
LOG_DIR=logs
# copy every run's log folder here (empty = not copied)
LOG_S3_URI=s3://dhms-new-stgae/DHMS/NSV/Pipeline/logs
